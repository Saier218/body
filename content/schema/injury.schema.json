{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "injury.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "sports",
    "structures",
    "status",
    "overview",
    "mechanism",
    "reported_signs",
    "red_flags",
    "general_principles",
    "prevention",
    "uncertainty",
    "disclaimer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "aliases": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "sports": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "structures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "involvement"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "involvement": { "enum": ["primary", "associated"] } }
      }
    },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "reviewed_at": { "$ref": "common.schema.json#/$defs/date" },
    "reviewed_by": { "type": "string", "description": "Name and credentials of the professional reviewer; required for expert-reviewed." },
    "overview": { "$ref": "common.schema.json#/$defs/sourcedText" },
    "mechanism": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
    "reported_signs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourcedText" },
      "description": "Signs as described in the literature. Never phrased as a way to self-assess."
    },
    "red_flags": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourcedText" },
      "description": "Situations in which the reader should be seen in person promptly."
    },
    "general_principles": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
    "grading": {
      "type": "object",
      "required": ["system", "grades"],
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "common.schema.json#/$defs/sourcedText" },
        "grades": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["grade", "definition", "sources"],
            "additionalProperties": false,
            "properties": {
              "grade": { "type": "string", "minLength": 1 },
              "definition": { "$ref": "common.schema.json#/$defs/text" },
              "reference_course": {
                "$ref": "common.schema.json#/$defs/text",
                "description": "What the cited source reports for this grade (ranges, not promises)."
              },
              "sources": { "$ref": "common.schema.json#/$defs/sourceRefs" }
            }
          }
        }
      }
    },
    "prevention": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
    "uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourcedText" },
      "description": "Where the evidence is weak, disputed or highly variable."
    },
    "disclaimer": { "enum": ["general"], "description": "Key of the disclaimer text shown with the entry." }
  }
}
