{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "sourcedText": {
      "type": "object",
      "required": ["zh", "en", "sources"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "sources": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "status": { "enum": ["draft", "sourced", "expert-reviewed"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
