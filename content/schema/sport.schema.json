{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sport.schema.json",
  "type": "object",
  "required": ["id", "name", "categories"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "$ref": "common.schema.json#/$defs/text" } }
      }
    }
  }
}
