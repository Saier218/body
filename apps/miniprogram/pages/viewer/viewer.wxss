page { background: #15171c; color: #e9e6df; font-size: 28rpx; }
.page { display: flex; flex-direction: column; height: 100vh; }
.stage { width: 100vw; height: 58vh; display: block; }
.panel { flex: 1; padding: 20rpx 28rpx; overflow: hidden; }
.title { font-size: 34rpx; font-weight: 600; min-height: 48rpx; }
.sub { color: #a9a59b; margin-top: 6rpx; min-height: 36rpx; }
.row { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.chip, .btn { padding: 12rpx 22rpx; margin: 0 14rpx 12rpx 0; border-radius: 999rpx; border: 2rpx solid #3a3e47; color: #a9a59b; min-height: 44rpx; line-height: 44rpx; }
.chip.on { border-color: #8fc4dd; color: #e9e6df; }
.btn { border-color: #5a5f6b; color: #e9e6df; }
.diag-title { margin-top: 14rpx; color: #a9a59b; font-size: 24rpx; }
.diag { font-size: 22rpx; color: #8d897f; line-height: 32rpx; font-family: Menlo, monospace; }
