{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/app/**/*.ts",
    "apps/miniprogram/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "node_modules"
  ]
}
